NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Supabase (get from project settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-min-32-chars

# Direct DB connection (for background jobs)
DATABASE_URL=postgresql://volleyball:volleyball_dev@localhost:5432/volleyball_db

# Redis
REDIS_URL=redis://localhost:6379

# Cloudflare (optional - for video uploads)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
